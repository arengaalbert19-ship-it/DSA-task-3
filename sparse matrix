#include <stdio.h>

int main()
{
    int a[10][10], sparse[100][3];
    int rows, cols, i, j, k =1;

    printf("Enter number of rows and columns: ");
    scanf("%d%d",&rows, &cols);

    printf("Enter matrix elements:\n");

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j< cols; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }
    sparse[0][0] = rows;
    sparse[0][1] = cols;

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < cols; j++)
        {
            if (a[i][j] != 0)
            {
                sparse[k][0] = i;
                sparse[k][1] = j;
                sparse[k][2] = a[i][j];

                k++;
            }
        }
    }
    sparse[0][2] = k -1;

    printf("\nSparse Matrix Representation:\n");
    printf("Row\tcolumn\tvalue\n");

    for (i =0; i < k; i++)
    {
        for (j = 0; j < 3; j++);
        {
            printf("%d\t", sparse[i][j]);
        }
        printf("\n");
    }
    return 0;
}